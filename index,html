<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Vote contra o tubarão</title>

<style>
body{
  margin:0;
  height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  font-family:Arial, Helvetica, sans-serif;
  background:white;
  overflow:hidden;
}

.container{
  text-align:center;
}

img{
  max-width:320px;
}

#contador{
  font-weight:bold;
  margin:15px 0;
  font-size:20px;
}

button{
  padding:14px 40px;
  font-size:18px;
  cursor:pointer;
}

/* ANIMAÇÃO QUANDO VOTA */
.votado{
  animation:zoom 0.4s ease;
}

@keyframes zoom{
  0%{transform:scale(1);}
  50%{transform:scale(1.2);}
  100%{transform:scale(1);}
}
</style>
</head>
<body>

<div class="container">
  <img src="https://upload.wikimedia.org/wikipedia/commons/5/56/White_shark.jpg">
  <h2>Vote contra o tubarão!</h2>
  <div id="contador">535 votos contra</div>
  <button id="votar">Votar</button>
</div>

<audio id="somAguia">
  <source src="https://upload.wikimedia.org/wikipedia/commons/5/5c/Bald_Eagle_Call.ogg" type="audio/ogg">
</audio>

<script>
let votos = 535;
const botao = document.getElementById("votar");
const contador = document.getElementById("contador");
const som = document.getElementById("somAguia");
const container = document.querySelector(".container");

botao.onclick = () => {
  votos++;
  contador.textContent = votos + " votos contra";

  /* animação */
  container.classList.add("votado");
  setTimeout(()=>container.classList.remove("votado"),400);

  /* som da águia bem alto */
  som.volume = 1;
  som.currentTime = 0;
  som.play();

  botao.disabled = true;
};
</script>

</body>
</html>
